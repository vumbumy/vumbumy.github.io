---
import { SITE, SITE_EN } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: URL;
  published?: Date;
  updated?: Date;
  tags?: string[];
  type?: "website" | "article";
  lang?: "ko" | "en";
  alternateKo?: URL;
  alternateEn?: URL;
  image?: URL;
  imageAlt?: string;
  breadcrumbs?: Array<{ name: string; url: URL }>;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical = Astro.url,
  published,
  updated,
  tags = [],
  type = "website",
  lang = "ko",
  alternateKo,
  alternateEn,
  image,
  imageAlt,
  breadcrumbs = [],
} = Astro.props;
const currentSite = lang === "en" ? SITE_EN : SITE;
const defaultTitle = lang === "en" ? SITE_EN.title : SITE.title;
const resolvedTitle = title === SITE.title && lang === "en" ? SITE_EN.title : title;
const resolvedDescription = description === SITE.description && lang === "en" ? SITE_EN.description : description;
const fullTitle = resolvedTitle === defaultTitle ? resolvedTitle : `${resolvedTitle} | ${currentSite.title}`;
const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const sitemapUrl = new URL(`${home}sitemap-index.xml`, Astro.site);
const resolvedImage = image ?? new URL(`${home}${lang === "en" ? "og-default-en.png" : "og-default.png"}`, Astro.site);
const resolvedImageAlt = imageAlt ?? currentSite.imageAlt;
const canonicalUrl = canonical.href;
const siteHome = new URL(lang === "en" ? `${home}en/` : home, Astro.site).href;
const configuredGaId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "").trim();
const gaMeasurementId = /^G-[A-Z0-9]+$/.test(configuredGaId) ? configuredGaId : "";
const googleSiteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? "").trim();
const pageJsonLd = type === "article"
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: resolvedTitle,
      description: resolvedDescription,
      image: resolvedImage.href,
      datePublished: published?.toISOString(),
      dateModified: (updated || published)?.toISOString(),
      author: { "@type": "Person", name: currentSite.author, url: currentSite.profileUrl, sameAs: [currentSite.linkedInUrl] },
      publisher: { "@type": "Person", name: currentSite.author, url: currentSite.profileUrl },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
      isPartOf: { "@type": "Blog", name: currentSite.title, url: siteHome },
      url: canonicalUrl,
      keywords: tags.join(", "),
      inLanguage: currentSite.language,
    }
  : {
      "@context": "https://schema.org",
      "@type": "Blog",
      name: currentSite.title,
      description: currentSite.description,
      url: canonicalUrl,
      image: resolvedImage.href,
      author: { "@type": "Person", name: currentSite.author, url: currentSite.profileUrl, sameAs: [currentSite.linkedInUrl] },
      inLanguage: currentSite.language,
    };
const jsonLd = breadcrumbs.length
  ? {
      "@context": "https://schema.org",
      "@graph": [
        { ...pageJsonLd, "@context": undefined },
        {
          "@type": "BreadcrumbList",
          itemListElement: breadcrumbs.map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.name,
            item: item.url.href,
          })),
        },
      ],
    }
  : pageJsonLd;
---

<!doctype html>
<html lang={currentSite.language}>
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") document.documentElement.dataset.theme = saved;
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="author" content={currentSite.author} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f4f7fb" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${home}favicon.svg`} type="image/svg+xml" />
    {alternateKo && <link rel="alternate" hreflang="ko" href={alternateKo} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {alternateKo && <link rel="alternate" hreflang="x-default" href={alternateKo} />}
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={currentSite.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={currentSite.locale} />
    {alternateKo && alternateEn && <meta property="og:locale:alternate" content={lang === "en" ? SITE.locale : SITE_EN.locale} />}
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={resolvedImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {type === "article" && <meta property="article:author" content={currentSite.author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {gaMeasurementId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>}
    {gaMeasurementId && (
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config','${gaMeasurementId}',{send_page_view:true});`}
      />
    )}
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header-wrap">
      <div class="site-header">
        <a class="brand" href={lang === "en" ? `${home}en/` : home}>
          <span class="brand-mark" aria-hidden="true">H</span>
          <span>{currentSite.title}</span>
        </a>
        <nav aria-label={lang === "en" ? "Primary navigation" : "주요 메뉴"}>
          <a href={lang === "en" ? `${home}en/` : home}>{lang === "en" ? "Posts" : "글"}</a>
          <a href={lang === "en" ? `${home}en/archive/` : `${home}archive/`}>{lang === "en" ? "Archive" : "아카이브"}</a>
          <a href={lang === "en" ? `${home}en/about/` : `${home}about/`}>{lang === "en" ? "About" : "소개"}</a>
          <a class="service-link" href={currentSite.profileUrl}>{lang === "en" ? "Profile · Projects" : "프로필·프로젝트"}<span aria-hidden="true">↗</span></a>
          <span class="language-toggle" aria-label={lang === "en" ? "Language" : "언어"}>
            <a class:list={{ active: lang === "ko" }} href={alternateKo?.pathname ?? home} hreflang="ko">KO</a>
            <a class:list={{ active: lang === "en" }} href={alternateEn?.pathname ?? `${home}en/`} hreflang="en">EN</a>
          </span>
          <button class="theme-toggle" type="button" aria-label={lang === "en" ? "Change color theme" : "색상 테마 전환"} aria-pressed="false">
            <span class="theme-icon" aria-hidden="true"></span>
          </button>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <span>© {new Date().getFullYear()} {currentSite.author}</span>
      <span>{lang === "en" ? "Notes on solving technical and organizational problems." : "기술과 조직의 문제를 풀며 남긴 기록입니다."}</span>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector(".theme-toggle");
        const currentTheme = () => root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const syncButton = () => button?.setAttribute("aria-pressed", String(currentTheme() === "dark"));
        syncButton();
        button?.addEventListener("click", () => {
          const current = root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          const next = current === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          localStorage.setItem("theme", next);
          syncButton();
        });
      })();
    </script>
    {gaMeasurementId && (
      <script is:inline>
        (() => {
          document.addEventListener("click", (event) => {
            const link = event.target instanceof Element ? event.target.closest("a") : null;
            if (!link) return;
            const url = new URL(link.href, location.href);
            if (url.hostname !== "vumy.kr" && url.hostname !== "www.vumy.kr") return;
            if (typeof window.gtag !== "function") return;
            window.gtag("event", "service_link_click", {
              link_url: url.href,
              link_text: link.textContent?.trim() || "",
              source_path: location.pathname,
            });
          });
        })();
      </script>
    )}
  </body>
</html>
