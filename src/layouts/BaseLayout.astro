---
import { SITE, SITE_EN } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: URL;
  published?: Date;
  updated?: Date;
  tags?: string[];
  type?: "website" | "article";
  lang?: "ko" | "en";
  alternateKo?: URL;
  alternateEn?: URL;
  image?: URL;
  imageAlt?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical = Astro.url,
  published,
  updated,
  tags = [],
  type = "website",
  lang = "ko",
  alternateKo,
  alternateEn,
  image,
  imageAlt,
} = Astro.props;
const currentSite = lang === "en" ? SITE_EN : SITE;
const defaultTitle = lang === "en" ? SITE_EN.title : SITE.title;
const resolvedTitle = title === SITE.title && lang === "en" ? SITE_EN.title : title;
const resolvedDescription = description === SITE.description && lang === "en" ? SITE_EN.description : description;
const fullTitle = resolvedTitle === defaultTitle ? resolvedTitle : `${resolvedTitle} | ${currentSite.title}`;
const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const sitemapUrl = new URL(`${home}sitemap-index.xml`, Astro.site);
const resolvedImage = image ?? new URL(`${home}og-default.png`, Astro.site);
const resolvedImageAlt = imageAlt ?? currentSite.imageAlt;
const canonicalUrl = canonical.href;
const siteHome = new URL(lang === "en" ? `${home}en/` : home, Astro.site).href;
const jsonLd = type === "article"
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: resolvedTitle,
      description: resolvedDescription,
      image: resolvedImage.href,
      datePublished: published?.toISOString(),
      dateModified: (updated || published)?.toISOString(),
      author: { "@type": "Person", name: currentSite.author },
      publisher: { "@type": "Person", name: currentSite.author },
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
      isPartOf: { "@type": "Blog", name: currentSite.title, url: siteHome },
      url: canonicalUrl,
      keywords: tags.join(", "),
      inLanguage: currentSite.language,
    }
  : {
      "@context": "https://schema.org",
      "@type": "Blog",
      name: currentSite.title,
      description: currentSite.description,
      url: canonicalUrl,
      image: resolvedImage.href,
      author: { "@type": "Person", name: currentSite.author },
      inLanguage: currentSite.language,
    };
---

<!doctype html>
<html lang={currentSite.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="author" content={currentSite.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${home}favicon.svg`} type="image/svg+xml" />
    {alternateKo && <link rel="alternate" hreflang="ko" href={alternateKo} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {alternateKo && <link rel="alternate" hreflang="x-default" href={alternateKo} />}
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={currentSite.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={currentSite.locale} />
    {alternateKo && alternateEn && <meta property="og:locale:alternate" content={lang === "en" ? SITE.locale : SITE_EN.locale} />}
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={resolvedImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={resolvedImageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {type === "article" && <meta property="article:author" content={currentSite.author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={lang === "en" ? `${home}en/` : home}>{currentSite.title}</a>
      <nav aria-label={lang === "en" ? "Primary navigation" : "주요 메뉴"}>
        <a href={lang === "en" ? `${home}en/` : home}>{lang === "en" ? "Posts" : "글"}</a>
        <a href={lang === "en" ? `${home}en/about/` : `${home}about/`}>{lang === "en" ? "About" : "소개"}</a>
        <span class="language-toggle" aria-label={lang === "en" ? "Language" : "언어"}>
          <a class:list={{ active: lang === "ko" }} href={alternateKo?.pathname ?? home} hreflang="ko">KO</a>
          <span aria-hidden="true">/</span>
          <a class:list={{ active: lang === "en" }} href={alternateEn?.pathname ?? `${home}en/`} hreflang="en">EN</a>
        </span>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} {currentSite.author}</footer>
  </body>
</html>
