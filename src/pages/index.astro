---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">WORK · SYSTEMS · DECISIONS</p>
    <h1>복잡한 고민을<br />다시 쓸 수 있는 판단으로.</h1>
    <p>{SITE.description}</p>
  </section>
  <section aria-labelledby="recent-posts">
    <div class="section-title">
      <h2 id="recent-posts">최근 글</h2>
      <span>{posts.length}개의 기록</span>
    </div>
    <div class="post-list">
      {posts.map((post) => (
        <article>
          <p class="post-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("ko-KR")}</time></p>
          <h3><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <ul class="tags" aria-label="태그">{post.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
