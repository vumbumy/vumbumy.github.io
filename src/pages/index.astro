---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { SITE } from "../config";
import { sortPosts } from "../lib/posts";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const latestPosts = posts.slice(0, 6);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout alternateKo={new URL(base, Astro.site)} alternateEn={new URL(`${base}en/`, Astro.site)}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> STAFF ENGINEER'S JOURNAL</p>
      <h1>{SITE.title}</h1>
      <p class="hero-description">{SITE.description}</p>
    </div>
    <aside class="hero-note">
      <span class="hero-note-label">HOW IT WORKS</span>
      <p>매일 남긴 업무 메모를 AI가 회고로 정리합니다.</p>
      <p>회사와 개인을 알아볼 수 있는 정보는 공개 전에 덜어냅니다.</p>
      <a href={SITE.profileUrl}>제가 만든 서비스 보기 <span aria-hidden="true">→</span></a>
    </aside>
  </section>
  <section aria-labelledby="recent-posts">
    <div class="section-title">
      <h2 id="recent-posts">최근 글</h2>
      <span>글 {posts.length}개</span>
    </div>
    <div class="post-list">
      {latestPosts.map((post) => <PostCard post={post} href={`${base}posts/${post.id}/`} />)}
    </div>
    {posts.length > latestPosts.length && <p class="archive-cta"><a href={`${base}archive/`}>모든 글 보기 <span aria-hidden="true">→</span></a></p>}
  </section>
</BaseLayout>
