---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { SITE } from "../config";
import { sortPosts } from "../lib/posts";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const latestPosts = posts.slice(0, 6);
const featuredPosts = ["2026-08-27-design-self-service-with-guardrails", "2026-08-13-make-verification-the-product", "2026-08-10-remove-deploy-access-after-automation"].map((id) => posts.find((post) => post.id === id)).filter((post): post is NonNullable<typeof post> => Boolean(post));
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout alternateKo={new URL(base, Astro.site)} alternateEn={new URL(`${base}en/`, Astro.site)}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> ENGINEER'S JOURNAL</p>
      <h1>{SITE.title}</h1>
      <p class="hero-description">{SITE.description}</p>
    </div>
    <aside class="hero-note">
      <span class="hero-note-label">WHAT I WRITE ABOUT</span>
      <p>AI로 만든 도구를 실제 업무에 연결할 때 생기는 데이터·권한·배포·운영의 문제를 다룹니다.</p>
      <p>직접 맡은 일에서 확인한 사실과 선택한 방법을 기록합니다.</p>
      <a href={SITE.profileUrl}>프로필·프로젝트 보기 <span aria-hidden="true">→</span></a>
    </aside>
  </section>
  <section aria-labelledby="start-here">
    <div class="section-title"><h2 id="start-here">먼저 읽을 글</h2><span>제작에서 검증과 배포까지</span></div>
    <div class="post-list">{featuredPosts.map((post) => <PostCard post={post} href={`${base}posts/${post.id}/`} />)}</div>
  </section>
  <section aria-labelledby="recent-posts">
    <div class="section-title">
      <h2 id="recent-posts">최근 글</h2>
      <span>글 {posts.length}개</span>
    </div>
    <div class="post-list">
      {latestPosts.map((post) => <PostCard post={post} href={`${base}posts/${post.id}/`} />)}
    </div>
    {posts.length > latestPosts.length && <p class="archive-cta"><a href={`${base}archive/`}>모든 글 보기 <span aria-hidden="true">→</span></a></p>}
  </section>
</BaseLayout>
