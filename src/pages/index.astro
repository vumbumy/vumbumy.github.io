---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">WORK NOTES</p>
    <h1>{SITE.title}</h1>
    <p>{SITE.description}</p>
    <p class="publishing-note">매일 남긴 업무 메모를 바탕으로 AI가 회고를 정리합니다. 공개 전에는 회사와 개인을 알아볼 수 있는 정보를 덜어냅니다.</p>
  </section>
  <section aria-labelledby="recent-posts">
    <div class="section-title">
      <h2 id="recent-posts">최근 글</h2>
      <span>글 {posts.length}개</span>
    </div>
    <div class="post-list">
      {posts.map((post) => (
        <article>
          <p class="post-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("ko-KR")}</time></p>
          <h3><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <ul class="tags" aria-label="태그">{post.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
