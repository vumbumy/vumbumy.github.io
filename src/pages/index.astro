---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout alternateKo={new URL(base, Astro.site)} alternateEn={new URL(`${base}en/`, Astro.site)}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> STAFF ENGINEER'S JOURNAL</p>
      <h1>{SITE.title}</h1>
      <p class="hero-description">{SITE.description}</p>
    </div>
    <aside class="hero-note">
      <span class="hero-note-label">HOW IT WORKS</span>
      <p>매일 남긴 업무 메모를 AI가 회고로 정리합니다.</p>
      <p>회사와 개인을 알아볼 수 있는 정보는 공개 전에 덜어냅니다.</p>
    </aside>
  </section>
  <section aria-labelledby="recent-posts">
    <div class="section-title">
      <h2 id="recent-posts">최근 글</h2>
      <span>글 {posts.length}개</span>
    </div>
    <div class="post-list">
      {posts.map((post, index) => (
        <article class:list={{ featured: index === 0 }}>
          <div class="post-card-meta">
            <p class="post-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("ko-KR")}</time></p>
            <span>{post.data.tags[0]}</span>
          </div>
          <h3><a href={`${base}posts/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          {post.data.decision && <p class="card-decision"><strong>선택</strong> {post.data.decision}</p>}
          <ul class="tags" aria-label="태그">{post.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
          <a class="card-link" href={`${base}posts/${post.id}/`} aria-label={`${post.data.title} 읽기`}><span>읽어보기</span><span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
