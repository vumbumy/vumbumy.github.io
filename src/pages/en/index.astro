---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_EN } from "../../config";

const posts = (await getCollection("postsEn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout lang="en" alternateKo={new URL(base, Astro.site)} alternateEn={new URL(`${base}en/`, Astro.site)}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> STAFF ENGINEER'S JOURNAL</p>
      <h1>{SITE_EN.title}</h1>
      <p class="hero-description">{SITE_EN.description}</p>
    </div>
    <aside class="hero-note">
      <span class="hero-note-label">HOW IT WORKS</span>
      <p>AI turns my rough daily notes into clear reviews.</p>
      <p>Company and personal details are removed before publishing.</p>
    </aside>
  </section>
  <section aria-labelledby="recent-posts">
    <div class="section-title">
      <h2 id="recent-posts">Recent posts</h2>
      <span>{posts.length} posts</span>
    </div>
    <div class="post-list">
      {posts.map((post, index) => (
        <article class:list={{ featured: index === 0 }}>
          <div class="post-card-meta">
            <p class="post-meta"><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time></p>
            <span>{post.data.tags[0]}</span>
          </div>
          <h3><a href={`${base}en/posts/${post.id}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          {post.data.decision && <p class="card-decision"><strong>DECISION</strong> {post.data.decision}</p>}
          <ul class="tags" aria-label="Tags">{post.data.tags.map((tag) => <li>#{tag}</li>)}</ul>
          <a class="card-link" href={`${base}en/posts/${post.id}/`} aria-label={`Read ${post.data.title}`}><span>Read article</span><span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
