---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { sortPosts, tagSlug } from "../../lib/posts";

const posts = sortPosts(await getCollection("postsEn", ({ data }) => !data.draft));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b, "en"));
const groups = Object.entries(Object.groupBy(posts, (post) => String(post.data.published.getFullYear())))
  .sort(([a], [b]) => Number(b) - Number(a));
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout lang="en" title="Post archive" description="Browse Hanbeom's notes on solving technical and team problems by year and topic." alternateKo={new URL(`${base}archive/`, Astro.site)} alternateEn={new URL(`${base}en/archive/`, Astro.site)}>
  <section class="archive-page">
    <header class="page-heading">
      <p class="eyebrow">ARCHIVE</p>
      <h1>Post archive</h1>
      <p>Browse past problems and choices by year or topic.</p>
    </header>
    <nav class="tag-cloud" aria-label="Browse by tag">
      {tags.map((tag) => <a href={`${base}en/tags/${tagSlug(tag)}/`}>#{tag}</a>)}
    </nav>
    {groups.map(([year, yearPosts]) => (
      <section class="archive-group" aria-labelledby={`year-${year}`}>
        <div class="section-title"><h2 id={`year-${year}`}>{year}</h2><span>{yearPosts?.length ?? 0} posts</span></div>
        <div class="post-list compact-list">{yearPosts?.map((post) => <PostCard post={post} href={`${base}en/posts/${post.id}/`} lang="en" />)}</div>
      </section>
    ))}
  </section>
</BaseLayout>
