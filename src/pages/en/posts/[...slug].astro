---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { adjacentPosts, relatedPosts, sortPosts, tagSlug } from "../../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getCollection("postsEn", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingMinutes = Math.max(1, Math.ceil((post.body ?? "").split(/\s+/).length / 220));
const decisionSummary = [
  ["PROBLEM", post.data.problem],
  ["DECISION", post.data.decision],
  ["OUTCOME", post.data.outcome],
].filter(([, value]) => value);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const allPosts = sortPosts(await getCollection("postsEn", ({ data }) => !data.draft));
const related = relatedPosts(post, allPosts);
const { previous, next } = adjacentPosts(post, allPosts);
const imageUrl = new URL(`${base}og/en/${post.id}.png`, Astro.site);
---

<BaseLayout
  lang="en"
  title={post.data.title}
  description={post.data.description}
  canonical={Astro.url}
  published={post.data.published}
  updated={post.data.updated}
  tags={post.data.tags}
  type="article"
  image={imageUrl}
  imageAlt={`${post.data.title} social sharing image`}
  breadcrumbs={[
    { name: "Home", url: new URL(`${base}en/`, Astro.site) },
    { name: "Posts", url: new URL(`${base}en/archive/`, Astro.site) },
    { name: post.data.title, url: Astro.url },
  ]}
  alternateKo={new URL(`${base}posts/${post.data.translationSlug ?? post.id}/`, Astro.site)}
  alternateEn={new URL(`${base}en/posts/${post.id}/`, Astro.site)}
>
  <article class="post">
    <header>
      <p class="eyebrow">{post.data.tags.map((tag, index) => <><a href={`${base}en/tags/${tagSlug(tag)}/`}>{tag}</a>{index < post.data.tags.length - 1 && <span>·</span>}</>)}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="post-meta">
        <time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
        <> · {readingMinutes} min read</>
        {post.data.updated && <> · Updated {post.data.updated.toLocaleDateString("en-US")}</>}
      </p>
    </header>
    {decisionSummary.length > 0 && (
      <dl class="decision-summary" aria-label="Article summary">
        {decisionSummary.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    )}
    <div class="article-grid">
      {headings.length > 1 && (
        <aside class="toc" aria-label="Table of contents">
          <p>In this article</p>
          <ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </aside>
      )}
      <div class="prose"><Content /></div>
    </div>
    <aside class="service-cta">
      <p class="eyebrow">MORE FROM HANBEOM</p>
      <h2>I also build services based on how I solve problems.</h2>
      <p>See the services and projects that I made.</p>
      <a href="https://vumy.kr/">See my services <span aria-hidden="true">→</span></a>
    </aside>
    <nav class="post-pagination" aria-label="Previous and next posts">
      {previous ? <a href={`${base}en/posts/${previous.id}/`}><span>Previous</span><strong>{previous.data.title}</strong></a> : <span></span>}
      {next && <a class="next" href={`${base}en/posts/${next.id}/`}><span>Next</span><strong>{next.data.title}</strong></a>}
    </nav>
    {related.length > 0 && <section class="related-posts"><div class="section-title"><h2>Related posts</h2></div><div class="post-list compact-list">{related.map((item) => <PostCard post={item} href={`${base}en/posts/${item.id}/`} lang="en" />)}</div></section>}
  </article>
</BaseLayout>
